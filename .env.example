# 复制为 .env 并填入真实值
# 兼容 OpenAI Chat Completions 格式的 API（minimax、OpenAI、DeepSeek 等通用）

# API 基础地址（minimax 默认 OpenAI 兼容端点）
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=your-api-key-here

# 使用的模型（默认 minimax Text-01；可改为 minimax-M3 或 GPT-4 / DeepSeek 等）
OPENAI_MODEL=minimax-Text-01

# 生成参数
TEMPERATURE=0.9
TOP_P=0.95
MAX_TOKENS=4096

# 章节字数目标（每章正文字数）
TARGET_CHAPTER_WORDS=3000

# 调试模式：DRY_RUN 为 true 时不调用 API，仅打印提示词
DRY_RUN=false
